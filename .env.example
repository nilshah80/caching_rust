# Server Configuration
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
SERVER__REQUEST_TIMEOUT_MS=30000
SERVER__MAX_BODY_SIZE_BYTES=10485760
SERVER__MAX_BATCH_SIZE=1000
SERVER__MAX_VALUE_SIZE_BYTES=524288
SERVER__CORS_ORIGINS=*

# Redis Connection
REDIS__URL=redis://localhost:6379
REDIS__PASSWORD=
REDIS__DATABASE=0
REDIS__TLS_ENABLED=false
REDIS__TLS_CERT_PATH=
REDIS__TLS_KEY_PATH=
REDIS__TLS_CA_PATH=
REDIS__TLS_SKIP_VERIFY=false

# Command Connection Pool
POOL__MIN_SIZE=2
POOL__MAX_SIZE=10
POOL__CONNECT_TIMEOUT_MS=5000
POOL__COMMAND_TIMEOUT_MS=5000
POOL__IDLE_TIMEOUT_MS=600000

# Pub/Sub Configuration
PUBSUB__MAX_SUBSCRIPTIONS=100
PUBSUB__CONNECTION_TIMEOUT_MS=30000

# Blocking Commands
BLOCKING__MAX_TIMEOUT_SECONDS=30
BLOCKING__DEFAULT_TIMEOUT_SECONDS=5
BLOCKING__MAX_SSE_CONNECTIONS=5
BLOCKING__DEFAULT_STREAM_READ_COUNT=100

# Admin
ADMIN__API_KEY=changeme-admin-key

# Rate Limiting
RATE_LIMIT__ENABLED=false
RATE_LIMIT__REQUESTS_PER_SECOND=100
RATE_LIMIT__BURST_SIZE=50

# Logging
LOG__LEVEL=info
LOG__FORMAT=json
# Optional: RUST_LOG overrides LOG__LEVEL when set
# RUST_LOG=redis_caching_service=debug,tower_http=info
