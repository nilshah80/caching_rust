# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_REQUEST_TIMEOUT_MS=30000

# Redis Connection
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TLS_ENABLED=false
REDIS_TLS_CERT_PATH=
REDIS_TLS_KEY_PATH=
REDIS_TLS_CA_PATH=
REDIS_TLS_SKIP_VERIFY=false

# Command Connection Pool
POOL_MIN_SIZE=2
POOL_MAX_SIZE=10
POOL_CONNECT_TIMEOUT_MS=5000
POOL_COMMAND_TIMEOUT_MS=5000
POOL_IDLE_TIMEOUT_MS=600000

# Pub/Sub Configuration (separate from pool)
PUBSUB_MAX_SUBSCRIPTIONS=100
PUBSUB_CONNECTION_TIMEOUT_MS=30000
PUBSUB_IDLE_TIMEOUT_MS=300000

# Blocking Commands
BLOCKING_MAX_TIMEOUT_SECONDS=30
BLOCKING_DEFAULT_TIMEOUT_SECONDS=5

# Admin
ADMIN_API_KEY=changeme-admin-key

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
# Use LOG_FORMAT=pretty for development
